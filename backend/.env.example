# ---------------------------------------------------------------------------
# Grievance Management System - backend configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ database
MONGO_URI=mongodb://localhost:27017/grievance_management
# Optional: override the database name from the URI
MONGO_DB_NAME=

# ----------------------------------------------------------------------- jwt
# REQUIRED. The app refuses to start without this.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY = 61100def5f18d5d8fbdf6196997b7a60469720f746fa58db82bcfb9e5fff30aa
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=12
JWT_ISSUER=dsvv-gms

# --- mobile sessions ---------------------------------------------------
# Only used by clients that identify as mobile ("client": "mobile" in the
# login body, or an X-Client-Type: mobile header). The website is unaffected
# and keeps using JWT_EXPIRY_HOURS above.
#
# The app gets a short access token plus a long-lived refresh token it can
# exchange at POST /api/auth/refresh, so a phone user is not asked to sign in
# twice a day. Refresh tokens are stored hashed and rotate on every use.
MOBILE_ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# --- mobile push notifications (Firebase Cloud Messaging) --------------
# Off by default; the in-app notification feed works without any of this.
#
# NEVER commit the service-account JSON. Keep it outside the repository and
# point FCM_CREDENTIALS_FILE at an absolute path. Sending also needs the
# `firebase-admin` package, which is optional - the backend runs without it.
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# ------------------------------------------------------------------- uploads
UPLOAD_FOLDER=uploads
# Bytes. 5 MB, matching the frontend's UPLOAD_LIMITS.
MAX_FILE_SIZE=5242880
MAX_FILES_PER_REQUEST=5

# ----------------------------------------------------------------------- otp
# Seconds a code stays valid.
OTP_EXPIRY=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
# true  -> the code is returned in the API response (development only)
# false -> the code is only delivered by the configured provider
#
# Defaults to false when unset. It is additionally ignored unless the process
# is really non-production (FLASK_DEBUG=true, a development/local FLASK_ENV, or
# the test suite), so setting it true on a deployed server does NOT leak codes.
OTP_DEV_MODE=false
# true -> registration requires a verified OTP first
OTP_REQUIRED_FOR_REGISTER=false

# ---------------------------------------------------------------------- mail
# SMTP delivery for OTP codes and complaint notifications.
#
# Entirely OPTIONAL. With MAIL_ENABLED=false the system runs exactly as it
# does today: notifications still appear in the in-app feed, and OTP codes are
# returned in the API response while OTP_DEV_MODE is on (development only).
#
# To turn real email on:
#   1. Put a real address in MAIL_USERNAME and a real password in MAIL_PASSWORD.
#      GMAIL: a normal account password will NOT work. Turn on 2-Step
#      Verification, then create an App Password at
#      https://myaccount.google.com/apppasswords and paste the 16-character
#      value here.
#   2. Set MAIL_ENABLED=true, and OTP_DEV_MODE=false so codes are only emailed.
#   3. Verify with:  python check_email.py you@example.com
#
#   STARTTLS (recommended)  MAIL_PORT=587  MAIL_USE_TLS=true   MAIL_USE_SSL=false
#   implicit TLS            MAIL_PORT=465  MAIL_USE_TLS=false  MAIL_USE_SSL=true
#
# NEVER commit a real MAIL_PASSWORD - `.env` is git-ignored for this reason.
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Defaults to MAIL_USERNAME when blank. Gmail rewrites this to the account
# address anyway, so leave it blank unless the provider allows a custom sender.
MAIL_DEFAULT_SENDER=
MAIL_SENDER_NAME=DSVV Grievance Portal
# Seconds to wait on any single SMTP operation.
MAIL_TIMEOUT=15
# true -> run the whole send path without opening a socket (testing only)
MAIL_SUPPRESS_SEND=false
# true -> also email complaint notifications, not just OTP codes
MAIL_NOTIFICATIONS_ENABLED=true

# ---------------------------------------------------------------------- cors
# Comma-separated. Never use "*" in production.
#
# If the frontend is hosted separately (for example on Vercel) its public
# origin MUST be added here, or the browser blocks every API call. Add the
# origin only - no trailing slash and no path:
#   CORS_ORIGINS=http://localhost:5500,https://your-project.vercel.app
# Vercel preview deployments get their own URLs, so add those you want to use.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# ----------------------------------------------------------------------- ocr
# OCR is optional; complaint submission works with it off.
# Turn on only after: pip install opencv-python pytesseract  (+ the Tesseract binary)
OCR_ENABLED=false
OCR_ENGINE=tesseract
# Full path to tesseract.exe if it is not on PATH, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# -------------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_OTP=5
RATE_LIMIT_WINDOW=60

# ------------------------------------------------------ SLA auto-escalation
# Complaints that pass their deadline escalate up a three-level ladder. That
# sweep has always been available on the admin screen (POST /api/admin/sla-check);
# these settings additionally run it on a timer, so escalation still happens on
# a server nobody is watching.
#
# OFF by default - with it false the server behaves exactly as it always has.
# Alternative: leave it false and point cron / Windows Task Scheduler at
# POST /api/admin/sla-check instead.
#
# Note: with several gunicorn workers each worker starts its own timer. The
# sweep is idempotent so that is safe, just wasteful - prefer one worker, or
# use the external-cron approach above.
SLA_AUTO_CHECK=false
SLA_CHECK_INTERVAL_MINUTES=60

# ----------------------------------------------------------------- behaviour
FLASK_ENV=development
FLASK_DEBUG=true
# Create the departments and demo accounts on start if they are missing.
SEED_ON_START=true
# Serve the frontend/ folder from Flask, so one server runs everything.
SERVE_FRONTEND=true
FRONTEND_FOLDER=frontend

# ------------------------------------------------------- seed account passwords
# Used only when the demo accounts are first created. Change these before any
# deployment that is reachable from outside your machine.
SEED_STUDENT_PASSWORD=student123
SEED_OFFICER_PASSWORD=officer123
SEED_ADMIN_PASSWORD=admin123

# --------------------------------------------------------------------- tests
TEST_MONGO_URI=mongodb://localhost:27017/grievance_management_test
