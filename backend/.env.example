# ---------------------------------------------------------------------------
# Grievance Management System - backend configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ database
MONGO_URI=mongodb://localhost:27017/grievance_management
# Optional: override the database name from the URI
MONGO_DB_NAME=

# ----------------------------------------------------------------------- jwt
# REQUIRED. The app refuses to start without this.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=12
JWT_ISSUER=dsvv-gms

# --- mobile sessions ---------------------------------------------------
# Only used by clients that identify as mobile ("client": "mobile" in the
# login body, or an X-Client-Type: mobile header). The website is unaffected
# and keeps using JWT_EXPIRY_HOURS above.
#
# The app gets a short access token plus a long-lived refresh token it can
# exchange at POST /api/auth/refresh, so a phone user is not asked to sign in
# twice a day. Refresh tokens are stored hashed and rotate on every use.
MOBILE_ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# --- mobile push notifications (Firebase Cloud Messaging) --------------
# Off by default; the in-app notification feed works without any of this.
#
# NEVER commit the service-account JSON. Keep it outside the repository and
# point FCM_CREDENTIALS_FILE at an absolute path. Sending also needs the
# `firebase-admin` package, which is optional - the backend runs without it.
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# ------------------------------------------------------------------- uploads
UPLOAD_FOLDER=uploads
# Bytes. 5 MB, matching the frontend's UPLOAD_LIMITS.
MAX_FILE_SIZE=5242880
MAX_FILES_PER_REQUEST=5

# ----------------------------------------------------------------------- otp
# Seconds a code stays valid.
OTP_EXPIRY=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
# true  -> the code is returned in the API response (development only)
# false -> the code is only delivered by the configured provider
#
# Defaults to false when unset. It is additionally ignored unless the process
# is really non-production (FLASK_DEBUG=true, a development/local FLASK_ENV, or
# the test suite), so setting it true on a deployed server does NOT leak codes.
OTP_DEV_MODE=false
# true -> registration requires a verified OTP first
OTP_REQUIRED_FOR_REGISTER=false

# ---------------------------------------------------------------------- cors
# Comma-separated. Never use "*" in production.
#
# If the frontend is hosted separately (for example on Vercel) its public
# origin MUST be added here, or the browser blocks every API call. Add the
# origin only - no trailing slash and no path:
#   CORS_ORIGINS=http://localhost:5500,https://your-project.vercel.app
# Vercel preview deployments get their own URLs, so add those you want to use.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# ----------------------------------------------------------------------- ocr
# OCR is optional; complaint submission works with it off.
# Turn on only after: pip install opencv-python pytesseract  (+ the Tesseract binary)
OCR_ENABLED=false
OCR_ENGINE=tesseract
# Full path to tesseract.exe if it is not on PATH, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# -------------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_OTP=5
RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------------- behaviour
FLASK_ENV=development
FLASK_DEBUG=true
# Create the departments and demo accounts on start if they are missing.
SEED_ON_START=true
# Serve the frontend/ folder from Flask, so one server runs everything.
SERVE_FRONTEND=true
FRONTEND_FOLDER=

# ------------------------------------------------------- seed account passwords
# Used only when the demo accounts are first created. Change these before any
# deployment that is reachable from outside your machine.
SEED_STUDENT_PASSWORD=student123
SEED_OFFICER_PASSWORD=officer123
SEED_ADMIN_PASSWORD=admin123

# --------------------------------------------------------------------- tests
TEST_MONGO_URI=mongodb://localhost:27017/grievance_management_test
