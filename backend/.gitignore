# Secrets - never commit the real environment file
.env
.env.local
.env.*.local

# Firebase service-account credentials for push notifications. Anyone holding
# this file can send push messages to every registered device, so it must stay
# out of the repository - keep it outside the project and point
# FCM_CREDENTIALS_FILE at it.
*serviceAccount*.json
*firebase-adminsdk*.json
firebase-credentials.json

# Uploaded files (keep the folder, ignore its contents)
uploads/*
!uploads/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
ENV/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
.env.bak*
