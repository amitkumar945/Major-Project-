# Secrets - never commit the real environment file
.env
.env.local
.env.*.local

# Firebase service-account credentials for push notifications. Anyone holding
# this file can send push messages to every registered device, so it must stay
# out of the repository - keep it outside the project and point
# FCM_CREDENTIALS_FILE at it.
*serviceAccount*.json
*firebase-adminsdk*.json
firebase-credentials.json

# Uploaded files (keep the folder, ignore its contents)
uploads/*
!uploads/.gitkeep
# Keep traversable, but ignored by default, only the historical fixture paths
# that were already tracked before they were moved under backend/.
!uploads/evidence/
uploads/evidence/**
!uploads/evidence/2026/
uploads/evidence/2026/**
!uploads/evidence/2026/09/
uploads/evidence/2026/09/**
!uploads/ocr/
uploads/ocr/**
!uploads/ocr/2026/
uploads/ocr/2026/**
!uploads/ocr/2026/09/
uploads/ocr/2026/09/**
