<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking: the app talks to the existing Flask backend. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS for tagging a complaint with its campus location. Coarse is
         declared alongside fine because Android 12+ lets the user grant only
         the approximate one, and the app works with either. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera for photographing the problem. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Gallery. READ_MEDIA_IMAGES is the Android 13+ replacement for
         READ_EXTERNAL_STORAGE, which is kept (capped) for older handsets. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ requires an explicit runtime prompt before posting
         notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app is useful without a camera or GPS (the pin can be dragged),
         so neither is required - marking them required would hide the app
         from tablets that lack them. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="DSVV Grievance"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="ac.dsvv.grievance.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Shown while Flutter warms up, so the launch is not a white
                 flash. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets a tapped FCM notification reach the Dart handler. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Complaint updates. Matching the channel created in PushService
             keeps foreground and background notifications consistent. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="grievance_updates" />
    </application>

    <!-- Android 11+ package visibility: needed for the image picker to see a
         camera app, and for opening links. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
